# Azure Functions uses Development only for local emulator provider selection.
AZURE_FUNCTIONS_ENVIRONMENT=Development

# Local Cosmos DB emulator. Never use connection strings or account keys in production.
COSMOSDB_ENDPOINT=https://localhost:8081/
COSMOSDB_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=<COSMOS_EMULATOR_KEY>;
COSMOSDB_DATABASE=honkbal

# Azure Functions host storage. Local development uses Azurite.
AzureWebJobsStorage=UseDevelopmentStorage=true

# In Azure, configure AzureWebJobsStorage with identity-based host settings and grant
# the Function App identity the required Storage Blob Data Owner/Queue Data Contributor roles.
# Production Cosmos access uses COSMOSDB_ENDPOINT plus managed identity RBAC.
